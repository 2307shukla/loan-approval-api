# Settings read from environment variables (see the README). Never commit real values.
# Required: token signing key, at least 32 bytes, e.g. openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Database: in-memory H2 by default; use PostgreSQL in production
DATABASE_URL=jdbc:h2:mem:loandb
DB_USERNAME=sa
DB_PASSWORD=
DB_POOL_SIZE=5
DDL_AUTO=update

PORT=8080
